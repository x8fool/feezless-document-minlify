  "logo": {
    "light": "/LOGO_Feezless1.png",
    "dark": "/LOGO_Feezless1.png",
    "href": "https://knownledge.feezless.cloud"
  },
  "navbar": {
    "links": [
      {
        "label": "ติดต่อฝ่ายสนับสนุน",
        "href": "https://makeform.ai/e/iY978F0d?__mf_modal_embed=1"
      }
    ],
    "primary": {
      "type": "button",
      "label": "เริ่มใช้งาน",
      "href": "https://makeform.ai/e/iY978F0d?__mf_modal_embed=1"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "facebook": "https://facebook.com/feezless.th",
      "youtube": "https://youtube.com/@feezless_th"
    }
  },
  "description": "เอกสารอย่างเป็นทางการของ Feezless Merchant Store Platform สำหรับนักพัฒนาและร้านค้า เรียนรู้การเชื่อมต่อ POS Cashier, Payment Link, Product Menu, Membership & Loyalty, Invoice & Bill Payment และ F402 Pay-Per-Request พร้อมคู่มือทีละขั้นตอนและเอกสารอ้างอิง API",
  "fonts": {
    "heading": {
      "family": "Open Sans"
    },
    "body": {
      "family": "Open Sans"
    }
  },
  "icons": {
    "library": "tabler"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E0E0E"
    },
    "decoration": "gradient"
  },
  "thumbnails": {
    "fonts": {
      "family": "Noto Sans Thai Looped"
    },
    "eyebrow": {
      "color": "#FFFFFF",
      "source": "none"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/th/index",
      "permanent": true
    },
    {
      "source": "/untitled-page",
      "destination": "/th/index",
      "permanent": true
    },
    {
      "source": "/th",
      "destination": "/th/index",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/th/index",
      "permanent": true
    },
    {
      "source": "/solutions/pay-per-request/index",
      "destination": "/th/solutions/pay-per-request/index",
      "permanent": true
    },
    {
      "source": "/solutions/checkout/index",
      "destination": "/th/solutions/checkout/index",
      "permanent": true
    },
    {
      "source": "/solutions/product-menu/index",
      "destination": "/th/solutions/product-menu/index",
      "permanent": true
    },
    {
      "source": "/solutions/pos/index",
      "destination": "/th/solutions/pos/index",
      "permanent": true
    },
    {
      "source": "/solutions/membership/index",
      "destination": "/th/solutions/membership/index",
      "permanent": true
    },
    {
      "source": "/solutions/invoice-bill-payment/index",
      "destination": "/th/solutions/invoice-bill-payment/index",
      "permanent": true
    },
    {
      "source": "/untitled-page-2",
      "destination": "/th/untitled-page-2",
      "permanent": true
    },
    {
      "source": "/th/untitled-page-2",
      "destination": "/th/index",
      "permanent": true
    },
    {
      "source": "/th/legal/embed",
      "destination": "/th/legal/terms-of-use",
      "permanent": false
    }
  ],
  "api": {
    "playground": {
      "credentials": true
    },
    "url": "full"
  },
  "appearance": {
    "default": "system"
  },
  "seo": {
    "metatags": {
      "og:title": "Feezless Merchant Store Platform"
    },
    "indexing": "all"
  },
  "styling": {
    "latex": true
  },
  "markdown": {
    "schema": true
  }
