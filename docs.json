{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Feezless | Document Payment Technology",
  "colors": {
    "primary": "#0E0E0E",
    "light": "#FDFDFD",
    "dark": "#0E0E0E"
  },
  "favicon": {
    "light": "/logo/light.svg",
    "dark": "/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index"
        ],
        "icon": "🗂️"
      },
      {
        "group": "Payment Solutions",
        "pages": [
          "solutions/pay-per-request/index",
          "solutions/checkout/index",
          "solutions/product-menu/index",
          "solutions/pos/index",
          "solutions/membership/index",
          "solutions/invoice-bill-payment/index",
          "untitled-page-2"
        ],
        "icon": "💲"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/images/feezless-logo-white-feez.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@feezless.cloud"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.feezless.cloud"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "facebook": "https://facebook.com/feezless.th",
      "youtube": "https://youtube.com/@feezless_th"
    }
  },
  "description": "Official Feezless API documentation for developers and businesses. Learn how to integrate payment acceptance, automate payouts, access transaction statements, configure webhooks, and create hosted payment pages with step-by-step guides and API references.",
  "fonts": {
    "heading": {
      "family": "Geist"
    },
    "body": {
      "family": "Geist"
    }
  },
  "icons": {
    "library": "tabler"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FDFDFD",
      "dark": "#0E0E0E"
    }
  },
  "thumbnails": {
    "surface": "neutral"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/index",
      "permanent": true
    },
    {
      "source": "/untitled-page",
      "destination": "/index",
      "permanent": true
    }
  ]
}
